{{> head}}
<body>
  <div class="app-shell dashboard-shell">
    <aside class="sidebar supplier-reference-sidebar">
      <a class="brand" href="/dashboard" aria-label="JAPZ GRILL home">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12.5 2.8c.5 3.2-1.6 4.4-3 6.1-1.2 1.4-1.8 2.8-1.8 4.5a4.3 4.3 0 0 0 8.6 0c0-1.2-.5-2.4-1.4-3.3.1 2-1 2.7-2 2.7-1.1 0-1.9-.9-1.9-2 0-1 .6-1.8 1.4-2.7 1.4-1.5 2.4-3.2 2.2-5.3 2.8 2.4 4.6 5.9 4.6 9.5a7.2 7.2 0 0 1-14.4 0c0-4 2.3-7.5 7.7-9.5Z"></path></svg></span>
        <span><strong>JAPZ<span>GRILL</span></strong><small>BURGER &amp; BISTRO</small></span>
      </a>
      <div class="nav-caption">OPERATIONS</div>
      <nav class="side-nav" aria-label="Main navigation">
        <a class="nav-item active" href="/dashboard"><span class="nav-icon">⊞</span> Dashboard</a>
        <a class="nav-item" href="/suppliers"><span class="nav-icon">♧</span> Suppliers <span class="nav-count">{{totalSuppliers}}</span></a>
        <a class="nav-item" href="/products"><span class="nav-icon">◇</span> Products &amp; supplies</a>
        <a class="nav-item" href="/orders"><span class="nav-icon">▤</span> Purchase orders <span class="nav-indicator"></span></a>
        <a class="nav-item" href="/deliveries"><span class="nav-icon">⬡</span> Deliveries</a>
        <a class="nav-item" href="/transactions"><span class="nav-icon">▣</span> Transactions</a>
        <a class="nav-item" href="/reports"><span class="nav-icon">♧</span> Reports</a>
      </nav>
      <div class="supplier-sidebar-bottom">
        <a class="nav-item supplier-settings-link" href="/settings"><span class="nav-icon">☷</span> Settings</a>
        <a class="supplier-business-link" href="/settings"><span class="supplier-business-mark">♧</span><span><strong>Japz Grill &amp; Bistro</strong><small>San Jose, Philippines</small></span><span class="supplier-business-chevron">⌃</span></a>
        <a class="supplier-user-link" href="/settings"><span class="supplier-user-avatar">JM</span><span><strong>J. Mendoza</strong><small>Administrator</small></span><span class="supplier-user-menu">•••</span></a>
      </div>
    </aside>
    <main class="main-content">
      <header class="topbar">
        <div class="breadcrumb"><strong>{{businessName}}</strong><span>›</span><strong>Dashboard</strong></div>
        <div class="topbar-right">
          <svg class="dashboard-date-icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="16" rx="2"></rect><path d="M7.5 3.5v3M16.5 3.5v3M3.5 9.5h17"></path></svg>
          <span class="today-label" id="today-label"></span>
          <span class="dashboard-notification" role="img" aria-label="Notifications"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"></path></svg><i></i></span>
          <span class="topbar-avatar">JG</span>
        </div>
      </header>

      <section class="page-content dashboard-content">
        <div class="welcome-row">
          <div>
            <div class="eyebrow">SUPPLIER OPERATIONS</div>
            <h1>Good morning, Japz team</h1>
            <p class="page-subtitle">Your kitchen supply chain at a glance.</p>
          </div>
          <a class="button button-primary" href="/orders?create=1"><span class="button-plus">+</span> Create purchase order</a>
        </div>

        {{#if successMessage}}<div class="notice notice-success" role="status">{{successMessage}}</div>{{/if}}
        {{#if errorMessage}}<div class="notice notice-error" role="alert">{{errorMessage}}</div>{{/if}}

        <section class="dashboard-hero" aria-label="Supply chain snapshot">
          <div class="dashboard-hero-copy">
            <div class="hero-eyebrow"><span></span> SUPPLY CHAIN SNAPSHOT</div>
            <h2>Fresh supplies. Smooth service.</h2>
            <p>Keep every delivery on track and every station ready for service.</p>
          </div>
          {{#if nextDeliveryLabel}}<span class="next-delivery">Next delivery · {{nextDeliveryLabel}}</span>{{/if}}
        </section>

        <section class="metrics-grid" aria-label="Supplier, purchasing, delivery, and payment summary">
          <article class="metric-card">
            <div class="metric-top"><span class="metric-label">Suppliers</span><span class="metric-icon icon-green">♧</span></div>
            <div class="metric-value">{{totalSuppliers}}</div>
            <div class="metric-foot">{{activeSuppliers}} active partners</div>
          </article>
          <article class="metric-card">
            <div class="metric-top"><span class="metric-label">Active suppliers</span><span class="metric-icon icon-khaki">♙</span></div>
            <div class="metric-value">{{activeSuppliers}}</div>
            <div class="metric-foot">Ready for new orders</div>
          </article>
          <article class="metric-card">
            <div class="metric-top"><span class="metric-label">Open purchase orders</span><span class="metric-icon icon-green">▤</span></div>
            <div class="metric-value">{{pendingOrders}}</div>
            <div class="metric-foot">Awaiting fulfillment</div>
          </article>
          <article class="metric-card">
            <div class="metric-top"><span class="metric-label">Deliveries this month</span><span class="metric-icon icon-khaki">⬡</span></div>
            <div class="metric-value">{{deliveriesThisMonth}}</div>
            <div class="metric-foot">Across all suppliers</div>
          </article>
          <article class="metric-card">
            <div class="metric-top"><span class="metric-label">Outstanding balance</span><span class="metric-icon icon-orange">▣</span></div>
            <div class="metric-value">{{currencySymbol}}{{outstandingPayments}}</div>
            <div class="metric-foot">Across active suppliers</div>
          </article>
        </section>

        <section class="dashboard-panels dashboard-top-panels">
          <article class="directory-card ops-card purchasing-card">
            <div class="directory-heading">
              <div><h2>Monthly purchasing</h2><p>Spend overview · {{currentYear}}</p></div>
              <a class="dashboard-text-link" href="/reports">Full report <span>↗</span></a>
            </div>
            <div class="purchasing-total"><strong>{{currencySymbol}}{{currentMonthPurchases}}</strong><span>Recorded this month</span></div>
            <div class="purchase-chart" role="img" aria-label="Monthly purchasing for the past 12 months">
              {{#each monthlyPurchasing}}
              <div class="chart-column" title="{{label}}: {{../currencySymbol}}{{total}}">
                <span class="chart-bar {{#if isCurrentMonth}}chart-bar-current{{/if}}" style="height: {{barHeight}}%"></span>
                <span class="chart-label">{{label}}</span>
              </div>
              {{else}}<div class="empty-message">Purchasing totals will appear after you create purchase orders.</div>{{/each}}
            </div>
            <div class="chart-footer"><span><i></i> Purchasing spend</span><small>Last updated just now</small></div>
          </article>

          <article class="directory-card ops-card activity-card">
            <div class="directory-heading">
              <div><h2>Recent activity</h2><p>Latest supplier updates</p></div>
              <a class="dashboard-text-link" href="/reports">View all <span>↗</span></a>
            </div>
            <div class="activity-list">
              {{#each recentActivities}}
              <a class="activity-item" href="{{href}}">
                <span class="activity-marker activity-{{kind}}"></span>
                <span class="activity-copy"><strong>{{label}}</strong><small>{{detail}}</small></span>
                <time>{{dateLabel}}</time>
              </a>
              {{else}}<div class="empty-message">Supplier activity will appear here as you use the system.</div>{{/each}}
            </div>
          </article>
        </section>

        <section class="dashboard-panels dashboard-bottom-panels">
          <article class="directory-card ops-card recent-orders-card">
            <div class="directory-heading">
              <div><h2>Recent purchase orders</h2><p>Track open and incoming orders</p></div>
              <a class="dashboard-text-link" href="/orders">All orders <span>↗</span></a>
            </div>
            <div class="table-wrap">
              <table class="supplier-table dashboard-orders-table">
                <thead><tr><th>ORDER</th><th>SUPPLIER</th><th>DUE DATE</th><th>AMOUNT</th><th>STATUS</th></tr></thead>
                <tbody>
                  {{#each recentOrders}}
                  <tr>
                    <td>{{orderNumber}}</td><td>{{supplierName}}</td><td>{{dueDateLabel}}</td>
                    <td>{{../currencySymbol}}{{totalAmount}}</td><td><span class="order-status {{statusClass}}">{{status}}</span></td>
                  </tr>
                  {{else}}<tr><td class="empty-message" colspan="5">No orders yet. Create your first purchase order.</td></tr>{{/each}}
                </tbody>
              </table>
            </div>
          </article>

          <article class="directory-card ops-card attention-card">
            <div class="directory-heading">
              <div><h2>Needs attention</h2><p>Items nearing reorder point</p></div>
              <a class="dashboard-text-link" href="/products">Inventory <span>↗</span></a>
            </div>
            <div class="frequent-items-list">
              {{#each lowStockSupplies}}
              <div class="frequent-item">
                <span class="frequent-item-mark">◇</span>
                <span class="frequent-item-copy"><strong>{{name}}</strong><small>{{supplierName}}</small></span>
                <span class="frequent-item-total">{{stockQuantity}} {{unit}} left</span>
              </div>
              {{else}}<div class="empty-message">All supplies are above their reorder points.</div>{{/each}}
            </div>
          </article>
        </section>
      </section>
    </main>
  </div>

  <script src="/js/supplier.js" defer></script>
{{> footer }}
